{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "radix-maia",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/index.css",
    "baseColor": "gray",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "hugeicons",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@magicui": {
      "url": "https://magicui.design/r/{name}.json"
    },
    "@aceternity": {
      "url": "https://ui.aceternity.com/registry/{name}.json"
    },
    "@coss": {
      "url": "https://coss.com/ui/r/{name}.json"
    },
    "@motion-primitives": {
      "url": "https://motion-primitives.com/c/{name}.json"
    },
    "@tailark": {
      "url": "https://tailark.com/r/{name}.json"
    },
    "@cult-ui": {
      "url": "https://cult-ui.com/r/{name}.json"
    }
  }
}
